{
  // サギカモ 本番構成: 1つのWorkerで静的アセット（dist/）とAPIを配信
  "name": "sagikamo",
  "main": "workers/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // 判定APIのレート制限（クレジット保護）: Durable Objectsで正確にカウント
  // IP単位 6回/分 ＋ 全体 30回/分
  "durable_objects": {
    "bindings": [{ "name": "RL_DO", "class_name": "JudgeRateLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["JudgeRateLimiter"] }],
  // シークレット: npx wrangler secret put ANTHROPIC_API_KEY で登録（コミット禁止）
  // LINE連携（Phase L）: LINE_CHANNEL_SECRET / LINE_CHANNEL_ACCESS_TOKEN も同様にsecretで登録

  // ステージング環境（Phase L検証用）。デプロイ: npm run deploy:staging
  // シークレットは環境ごとに別登録: npx wrangler secret put <NAME> --env staging
  // ※assets / durable_objects はトップレベルを継承しないため再定義する
  "env": {
    "staging": {
      "name": "sagikamo-staging",
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application"
      },
      "durable_objects": {
        "bindings": [{ "name": "RL_DO", "class_name": "JudgeRateLimiter" }]
      }
    }
  }
}
