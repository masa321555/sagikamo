{
  // サギカモ 本番構成: 1つのWorkerで静的アセット（dist/）とAPIを配信
  "name": "sagikamo",
  "main": "workers/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
  // シークレット: npx wrangler secret put ANTHROPIC_API_KEY で登録（コミット禁止）
}
